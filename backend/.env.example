# Resend API key from https://resend.com
RESEND_API_KEY=your_resend_api_key

# Email recipient for backend notifications
ADMIN_EMAIL=you@example.com

# Sender email address for outgoing messages
FROM_EMAIL=contact@illyriancycling.cc

# Friendly site name used in email copy
SITE_NAME=Illyrian Cycling

# Port for development
PORT=3000

# Optional CORS allow list for frontend hosting domains
# Example: https://illyriancycling.cc,https://another-domain.com
ALLOWED_ORIGINS=https://illyriancycling.cc

# Location of the background music track streamed by the /audio proxy
MUSIC_URL=https://github.com/IllyrianCycling/website/releases/download/audio-v1/Supersonic.Shadows.mp3
